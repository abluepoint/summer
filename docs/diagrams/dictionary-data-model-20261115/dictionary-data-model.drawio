        <mxCell id="logical-versions" value="逻辑版本归属 1 : 0..N　(tenant_id, code → dictionary_code)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7a869a;dashPattern=2 5;startArrow=none;endArrow=open;endFill=0;fontFamily=Helvetica;fontColor=#172b4d;" edge="1" parent="1" source="summer_dictionary_type" target="summer_dictionary_version" data-model-id="logical-versions" data-kind="logical-reference">
