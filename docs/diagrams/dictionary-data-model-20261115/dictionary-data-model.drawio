        <mxCell id="summer_dictionary_group_member-constraints-text" value="UK (tenant_id, dictionary_code, group_id, item_id)&lt;br&gt;两组复合 FK 限定同企业、同字典&lt;br&gt;组内 sort_order 独立；删除组或项级联删成员" style="shape=partialRectangle;horizontal=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;top=1;left=0;right=0;bottom=0;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=12;fontSize=13;fontFamily=Helvetica;fontColor=#172b4d;" vertex="1" parent="summer_dictionary_group_member-constraints">
