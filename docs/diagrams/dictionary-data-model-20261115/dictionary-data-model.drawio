        <mxCell id="summer_dictionary_notification_event-constraints-text" value="event_id：自增 BIGINT，供增量订阅游标使用&lt;br&gt;与 Outbox 的 UUID 事件主键不同&lt;br&gt;无 outbox_id，也无到 Outbox 的外键" style="shape=partialRectangle;horizontal=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;top=1;left=0;right=0;bottom=0;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=12;fontSize=13;fontFamily=Helvetica;fontColor=#172b4d;" vertex="1" parent="summer_dictionary_notification_event-constraints">
          <mxGeometry x="0" y="0" width="450" height="86" as="geometry" />
        </mxCell>
        <mxCell id="logical-overrides" value="逻辑 1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#7a869a;dashPattern=2 5;startArrow=none;endArrow=open;endFill=0;fontFamily=Helvetica;fontColor=#172b4d;" edge="1" parent="1" source="summer_dictionary_type" target="summer_configuration_override" data-model-id="logical-overrides" data-kind="logical-reference">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fk_configuration_override_revision" value="1 : 0..N&lt;br&gt;id → override_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.57;entryDx=0;entryDy=0;strokeColor=#3b67a3;dashPattern=8 4;startArrow=ERmandOne;startFill=0;endArrow=ERmany;endFill=0;fontFamily=Helvetica;fontColor=#172b4d;" edge="1" parent="1" source="summer_configuration_override" target="summer_configuration_override_revision" data-model-id="fk_configuration_override_revision" data-kind="foreign-key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="logical-outbox" value="逻辑 1 : 0..N&lt;br&gt;tenant_id + dictionary_code&lt;br&gt;版本操作写入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7a869a;dashPattern=2 5;startArrow=none;endArrow=open;endFill=0;fontFamily=Helvetica;fontColor=#172b4d;" edge="1" parent="1" source="summer_dictionary_type" target="summer_dictionary_outbox" data-model-id="logical-outbox" data-kind="logical-reference">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="logical-notifications" value="逻辑 1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7a869a;dashPattern=2 5;startArrow=none;endArrow=open;endFill=0;fontFamily=Helvetica;fontColor=#172b4d;" edge="1" parent="1" source="summer_dictionary_type" target="summer_dictionary_notification_event" data-model-id="logical-notifications" data-kind="logical-reference">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="379" />
              <mxPoint x="580" y="790" />
              <mxPoint x="875" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="support-invariants" value="&lt;b&gt;覆盖与事件的边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;配置覆盖表供多类配置共享；只有 resource = dictionaries 的记录属于字典模型。&lt;br&gt;&lt;br&gt;覆盖值保留独立修订历史；优先级：当前组织 → 企业（_tenant）→ 基础发布版本。&lt;br&gt;&lt;br&gt;发布、停用、回滚操作写入 Outbox 与通知表；二者是并列记录，不是父子表。覆盖事件也可触发通知。&lt;br&gt;&lt;br&gt;蓝色长虚线 + 乌鸦脚 = 真实 FK；灰色点线 + 箭头 = 逻辑关联。权限、菜单、审计使用通用模块，未展开。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#d1d9e3;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Helvetica;fontColor=#172b4d;" vertex="1" parent="1">
          <mxGeometry x="1240" y="860" width="450" height="465" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
