        </mxCell>
        <mxCell id="snapshot-structure" value="&lt;b&gt;snapshot_json：快照内容&lt;/b&gt;&lt;br&gt;&lt;br&gt;name / publicReadable / enabled / formatVersion&lt;br&gt;&lt;br&gt;items[]：value、label、sortOrder、enabled、description&lt;br&gt;&lt;br&gt;groups[]：id、code、name、enabled、memberValues[]（有序）&lt;br&gt;&lt;br&gt;字典、项、分组和成员顺序一起发布；没有单独的版本项表或版本分组表。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#d1d9e3;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Helvetica;fontColor=#172b4d;" vertex="1" parent="1">
          <mxGeometry x="1240" y="780" width="450" height="420" as="geometry" />
        </mxCell>
        <mxCell id="core-invariants" value="&lt;b&gt;模型规则与读图说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;分组是字典项的子集；同一项可属于多个分组。字典本身没有 parent_id 层级结构。&lt;br&gt;&lt;br&gt;published_version 按 (tenant_id, code, version_number) 逻辑定位生效快照；回滚切换该指针，保留当前草稿。&lt;br&gt;&lt;br&gt;蓝色长虚线 + 乌鸦脚 = 数据库外键（1 : 0..N）；灰色点线 + 箭头 = 逻辑关联，无数据库外键。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#d1d9e3;align=left;verticalAlign=top;spacing=18;fontSize=14;fontFamily=Helvetica;fontColor=#172b4d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1235" width="1630" height="148" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
