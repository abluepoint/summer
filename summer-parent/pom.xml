<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.abluepoint.summer</groupId>
    <artifactId>summer-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-starter-parent</artifactId>
        <version>2022.0.1</version>
    </parent>

    <modules>
        <module>../summer-automator</module>
        <module>../summer-common</module>
        <module>../summer-data-jpa</module>
        <module>../summer-mvc</module>
        <module>../summer-security</module>
        <module>../summer-boot-starter</module>
        <module>../summer-data-jpa-test</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.source>17</maven.compiler.source>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <summer.version>4.0.0-SNAPSHOT</summer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.abluepoint.summer</groupId>
                <artifactId>summer-automator</artifactId>
                <version>${summer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.abluepoint.summer</groupId>
                <artifactId>summer-common</artifactId>
                <version>${summer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.abluepoint.summer</groupId>
                <artifactId>summer-data-jpa</artifactId>
                <version>${summer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.abluepoint.summer</groupId>
                <artifactId>summer-security</artifactId>
                <version>${summer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.abluepoint.summer</groupId>
                <artifactId>summer-mvc</artifactId>
                <version>${summer.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.security.oauth</groupId>
                <artifactId>spring-security-oauth2</artifactId>
                <version>2.3.5.RELEASE</version>
            </dependency>
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>3.4.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.9</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>1.0.35</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.14.0</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.22</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid</artifactId>
                <version>1.2.11</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>1.6</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <name>teleinfo-releases</name>
            <url>https://nexus.teleinfo.cn:9443/nexus/repository/maven-releases/</url>
        </repository>

        <snapshotRepository>
            <id>snapshots</id>
            <name>teleinfo-snapshots</name>
            <url>https://nexus.teleinfo.cn:9443/nexus/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

</project>